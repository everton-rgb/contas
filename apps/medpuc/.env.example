# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API Keys).
#
# Use SOMENTE a chave pública (publishable, "sb_publishable_..."; ou a
# "anon" legada). Nunca coloque a secret key / service_role aqui: tudo que
# começa com VITE_ vai para o navegador. O app se recusa a iniciar se
# detectar uma chave secreta.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
